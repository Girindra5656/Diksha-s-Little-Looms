# ------------------------------------------------------------------
# Diksha's Little Looms — environment variables
# Copy this file to ".env" and fill in real values.
# ------------------------------------------------------------------

# Secret used to sign login sessions. Use a long random string.
# Generate one by running:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-this-to-a-long-random-string"

# Database connection.
# LOCAL (default, easiest): SQLite file — nothing to install.
DATABASE_URL="file:./dev.db"

# PRODUCTION (when you deploy accounts to Vercel), use a free Postgres
# database from https://neon.tech and paste its URL here instead, e.g.:
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
# (If you use Postgres, also change provider to "postgresql" in prisma/schema.prisma)

# The first admin account created by the seed script.
ADMIN_EMAIL="diksha11081993@gmail.com"
ADMIN_PASSWORD="Diksha@Looms2025"
ADMIN_NAME="Diksha"
